# Copy to .env (never commit .env). Only needed for local dev / db migrations.
# These VITE_ values end up in the PUBLIC JavaScript bundle: use publishable/anon keys only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key>

# Name of the deployed Edge Function (default: scan-form)
# VITE_OCR_FUNCTION_NAME=scan-form

# Optional legacy fallback (engines are disabled by default, see ENGINES in src/lib/ocrEngine.ts)
# VITE_GEMINI_API_KEY=

# Only for `npm run db:migrate` (server-side, NEVER prefix with VITE_)
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
